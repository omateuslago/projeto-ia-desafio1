dataset_pessoas/
dataset_emocoes/

# Modelos e resultados gerados durante o treinamento
modelos/
resultados/

# Áudios, CSVs, gráficos e relatórios das reuniões
reunioes/

# Arquivos de áudio avulsos usados em testes locais
*.wav
*.mp3
*.flac
*.ogg

# Logs e arquivos temporários
*.log
*.tmp
*.temp
~$*
