# Ambientes virtuais Python
.venv/
venv/
env/
ENV/

# Cache e arquivos compilados do Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Distribuição e empacotamento
build/
dist/
*.egg-info/
.eggs/

# Configurações locais e segredos
.env
.env.*
!.env.example

# Editores e sistema operacional
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Datasets de voz e emoções
